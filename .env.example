# Configure these in Vercel Project Settings > Environment Variables.
# ASP.NET does not automatically load this file; keep real .env files out of Git.
DATABASE_URL=postgresql://neondb_owner:REPLACE_WITH_ROTATED_PASSWORD@YOUR-ENDPOINT-pooler.c-15.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
# Required for Neon database setup: use the hostname WITHOUT -pooler.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_WITH_ROTATED_PASSWORD@YOUR-ENDPOINT.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require
# Alternative Neon/Vercel aliases; choose these instead of the URLs above if needed.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# Or construct the connection from components (POSTGRES_HOST/USER/PASSWORD/DATABASE also work).
# PGHOST=YOUR-ENDPOINT-pooler.c-15.us-east-1.aws.neon.tech
# PGHOST_UNPOOLED=YOUR-ENDPOINT.c-15.us-east-1.aws.neon.tech
# PGUSER=neondb_owner
# PGDATABASE=neondb
# PGPASSWORD=REPLACE_WITH_ROTATED_PASSWORD
# PGSSLMODE=verify-full
# PGCHANNELBINDING=require
# PGCONNECT_TIMEOUT=15
AdminSeed__Email=admin@example.com
AdminSeed__Password=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Needed only when enabling photo uploads. Supply one credential format.
GoogleDrive__CredentialsBase64=
# GoogleDrive__CredentialsJson=

# Optional RSVP notifications.
RsvpEmail__Enabled=false
RsvpEmail__Host=
RsvpEmail__Port=587
RsvpEmail__UseSsl=true
RsvpEmail__Username=
RsvpEmail__Password=
RsvpEmail__From=
RsvpEmail__Recipient=
