@using System.Globalization
@model HomeViewModel
@{
    ViewData["Title"] = "Home";

    var settings = Model.Settings;
}

<section class="hero" style="--primary: @settings.PrimaryColor; --secondary: @settings.SecondaryColor">
    <div class="container">
        <div class="row align-items-center min-vh-75 g-5">
            <div class="col-lg-6">
                <p class="eyebrow">
                    <i class="bi bi-heart"></i> @settings.BrideName & @settings.GroomName
                </p>

                <h1>@settings.HomeHeroTitle</h1>

                <p class="lead">@settings.HomeHeroSubtitle</p> 
                
                @if (settings.WeddingDateTime.HasValue)
                {
                    <div id="countdown" class="countdown" data-wedding-date="@settings.WeddingDateTime.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)">
                        <div>
                            <strong data-days>--</strong>
                            <span>Dias</span>
                        </div>
                        <div>
                            <strong data-hours>--</strong>
                            <span>Horas</span>
                        </div>
                        <div>
                            <strong data-minutes>--</strong>
                            <span>Minutos</span>
                        </div>
                        <div>
                            <strong data-seconds>--</strong>
                            <span>Segundos</span>
                        </div>
                    </div>   

                    <p class="mt-3">
                        <i class="bi bi-calendar-heart"></i> @settings.WeddingDateTime.Value.ToString("dddd, dd MMMM yyyy HH:mm")
                    </p>
                } 
                else
                {
                    <div class="alert alert-light">A data do nosso casamento será anunciada em breve</div>
                }

                <p>
                    <i class="bi bi-geo-alt"></i> @settings.CeremonyLocationName
                </p>

                <a class="btn btn-primary btn-lg rounded-pill" asp-controller="Rsvp" asp-action="Index">Confirmar Presença</a>
            </div>

            <div class="col-lg-6">
                <img class="hero-img" src="/images/homepage-couple.png" alt="Couple Photo Placeholder" />
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-6">
            <h2>A Nossa História</h2>
            <p class="story">@settings.CoupleStory</p>
        </div>

        <div class="col-lg-6">
            <div id="storyCarousel" class="carousel slide elegant-card" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.CarouselImages.Count; i++)
                    {
                        <div class="carousel-item @(i == 0? " active" : "")">
                            <img src="@Model.CarouselImages[i]" class="d-block w-100 story-img" alt="Story Image" />
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#storyCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <button class="carousel-control-next" type="button" data-bs-target="#storyCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}