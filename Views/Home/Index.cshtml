@using System.Globalization
@model HomeViewModel
@inject CasamentoTatianaDiogo.Services.Interfaces.ISiteContentService SiteContent
@{
    ViewData["Title"] = "Home";

    var settings = Model.Settings;
    var portugueseCulture = new CultureInfo("pt-PT");
    var siteText = await SiteContent.GetAsync();
}

<section class="hero hero-photo" style="--primary: @settings.PrimaryColor; --secondary: @settings.SecondaryColor">
    <div class="container hero-content">
        <div class="hero-intro">
            <h1 class="couple-names">
                <span class="couple-name">@settings.BrideName</span>
                <span class="couple-name couple-name-second"><span class="couple-ampersand">&amp;</span> @settings.GroomName</span>
            </h1>

            @if (settings.WeddingDateTime.HasValue)
            {
                <div id="countdown" class="countdown" data-wedding-date="@settings.WeddingDateTime.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)">
                    <div><strong data-days>--</strong><span>Dias</span></div>
                    <div><strong data-hours>--</strong><span>Horas</span></div>
                    <div><strong data-minutes>--</strong><span>Mins.</span></div>
                    <div><strong data-seconds>--</strong><span>Segs.</span></div>
                </div>
            }

            <a class="btn btn-primary btn-lg rounded-pill hero-rsvp" asp-controller="Rsvp" asp-action="Index">@siteText.GetValueOrDefault("HomeRsvpCta", "Confirmar presença")</a>
        </div>

        <div class="event-cards">
            @if (settings.WeddingDateTime.HasValue)
            {
                var weddingDay = settings.WeddingDateTime.Value.ToString("dddd", portugueseCulture);
                var monthName = settings.WeddingDateTime.Value.ToString("MMMM", portugueseCulture);
                var weddingDate = settings.WeddingDateTime.Value.ToString("dd 'de' MMMM 'de' yyyy", portugueseCulture)
                    .Replace(monthName, $"{char.ToUpper(monthName[0], portugueseCulture)}{monthName[1..]}");

                <div class="event-card">
                    <i class="bi bi-calendar-heart event-icon" aria-hidden="true"></i>
                    <p class="event-day">@($"{char.ToUpper(weddingDay[0], portugueseCulture)}{weddingDay[1..]}")</p>
                    <p class="event-date">@weddingDate</p>
                </div>
            }

            <div class="event-card">
                <i class="bi bi-geo-alt-fill event-icon" aria-hidden="true"></i>
                <p class="event-location">@settings.CeremonyLocationName, @settings.CeremonyAddress</p>
                <p class="event-location">@settings.ReceptionLocationName, @settings.ReceptionAddress</p>
            </div>
        </div>
    </div>
</section>

<section class="container py-5 home-story-section">
    <div class="row g-5 align-items-stretch">
        <div class="col-lg-6 story-copy">
            <h2>@siteText.GetValueOrDefault("HomeStoryTitle", "A nossa história")</h2>
            <p class="story">@settings.CoupleStory</p>
        </div>

        <div class="col-lg-6 story-media">
            <div id="storyCarousel" class="carousel slide elegant-card story-carousel" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.CarouselImages.Count; i++)
                    {
                        <div class="carousel-item @(i == 0? " active" : "")">
                            <img src="@Model.CarouselImages[i]" class="d-block w-100 story-img" alt="Story Image" />
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#storyCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <button class="carousel-control-next" type="button" data-bs-target="#storyCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
