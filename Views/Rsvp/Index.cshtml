@model RsvpSearchViewModel
@{
    ViewData["Title"] = "RSVP";
}

<section class="page-header">
    <div class="container">
        <h1>
            <i class="bi bi-envelope-heart"></i> Confirmar Presença
        </h1>
        <p>Pesquisa por primeiro ou último nome.</p>
    </div>
</section>

<div class="container py-5 narrow">
    <form asp-action="Search" method="post" class="elegant-card p-4 rsvp-search-card" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <label class="form-label" for="guest-search">Nome do Convidado</label>

        <div class="input-group">
            <input asp-for="Query" id="guest-search" class="form-control" placeholder="Primeiro ou Último Nome" autocomplete="off" spellcheck="false" />
            <button class="btn btn-primary">
                <i class="bi bi-search"></i> Pesquisar
            </button>
        </div>
        <span asp-validation-for="Query" class="text-danger"></span>
    </form>

    @if(Model.Message != null)
    {
        <div class="feedback-card feedback-card-warning mt-3" role="status">
            <i class="bi bi-search-heart" aria-hidden="true"></i>
            <span>@Model.Message</span>
        </div>
    }

    @if (Model.Results?.Any() == true)
    {
        <div class="mt-4">
            <h3 class="rsvp-results-title">Seleciona o teu Nome</h3>

            @foreach(var guest in Model.Results)
            {
                <a class="guest-result" asp-action="Select" asp-route-id="@guest.Id">
                    <span class="guest-avatar guest-result-avatar" style="--avatar-scale:@guest.AvatarScale.ToString(System.Globalization.CultureInfo.InvariantCulture);--avatar-position-x:@guest.AvatarPositionX%;--avatar-position-y:@guest.AvatarPositionY%;">
                        @if (!string.IsNullOrWhiteSpace(guest.ProfileImagePath))
                        {
                            <img src="@guest.ProfileImagePath" alt="" />
                        }
                        else
                        {
                            <i class="bi bi-person-heart"></i>
                        }
                    </span>
                    <span class="guest-result-details"><strong>@guest.DisplayName</strong><small>@guest.Family?.Name</small></span>
                    <i class="bi bi-arrow-right-short guest-result-arrow" aria-hidden="true"></i>
                </a>
            }
        </div>
    }
</div>

@if (ViewData["RsvpJustSubmitted"] is true)
{
    <div class="modal fade" id="rsvp-back-navigation-modal" tabindex="-1" aria-labelledby="rsvp-back-navigation-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rsvp-back-navigation-card">
                <div class="modal-body text-center p-4 p-md-5">
                    <span class="rsvp-back-navigation-icon" aria-hidden="true"><i class="bi bi-arrow-left-circle"></i></span>
                    <p class="rsvp-back-navigation-label">Resposta enviada</p>
                    <h2 id="rsvp-back-navigation-title">Queres voltar à pesquisa?</h2>
                    <p class="rsvp-back-navigation-message mb-0">A resposta já foi guardada. Ao voltar, irás para a pesquisa de convidados e não para o formulário submetido.</p>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0 pb-4 px-4 px-md-5 gap-2">
                    <button type="button" class="btn btn-outline-primary" data-rsvp-back-stay>Ficar nesta página</button>
                    <button type="button" class="btn btn-primary" data-rsvp-back-search><i class="bi bi-search me-1"></i> Voltar à pesquisa</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    @if (ViewData["RsvpJustSubmitted"] is true)
    {
        <script src="~/js/rsvp-back-navigation.js" asp-append-version="true"></script>
    }
}

@section Styles
{
    <link rel="stylesheet" href="~/css/pages/rsvp.css" asp-append-version="true" />
}
