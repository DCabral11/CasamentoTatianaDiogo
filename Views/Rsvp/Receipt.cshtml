@inject CasamentoTatianaDiogo.Services.Interfaces.IWeddingSettingsService ContactSettings
@model RsvpReceiptViewModel
@inject CasamentoTatianaDiogo.Services.WeddingClock Clock
@{
    ViewData["Title"] = T("Recibo da resposta RSVP");
}
<section class="page-header rsvp-header">
    <div class="container narrow">
        <p class="mb-2"><i class="bi bi-check-circle" aria-hidden="true"></i> @T("Resposta guardada com sucesso")</p>
        <h1>@T("O teu recibo RSVP")</h1>
        <p>@T("Obrigado pela resposta! Revê abaixo os dados que ficaram registados neste envio.")</p>
    </div>
</section>
<div class="container py-4 py-md-5 narrow rsvp-receipt">
    <section class="elegant-card p-4 mb-4" aria-labelledby="receipt-summary-title">
        <h2 id="receipt-summary-title" class="h4">@T("Resumo da confirmação")</h2>
        <dl class="receipt-details">
            <dt>@T("Referência do recibo")</dt><dd class="receipt-reference">@Model.Reference</dd>
            <dt>@T("Data e hora do envio")</dt><dd><time datetime="@Model.SavedAtUtc.ToString("O")">@Clock.ToLocal(Model.SavedAtUtc).ToString(T("dd/MM/yyyy 'às' HH:mm"))</time> (@Clock.TimeZoneId)</dd>
            <dt>@T("Email verificado")</dt><dd>@(CasamentoTatianaDiogo.Services.ContactFormats.Email(Model.VerifiedContact, await ContactSettings.GetAsync())?.Display ?? Model.VerifiedContact)</dd>
        </dl>
        <div class="row g-3 mt-1">
            <div class="col-6"><div class="receipt-total"><strong>@Model.Attending</strong><span>@T("Presenças confirmadas")<br /><small>@T("Inclui acompanhantes")</small></span></div></div>
            <div class="col-6"><div class="receipt-total"><strong>@Model.NotAttending</strong><span>@T("Não vão comparecer")</span></div></div>
        </div>
        <p class="small mt-3 mb-0">@T("Este recibo inclui apenas as pessoas selecionadas neste envio. As respostas dos restantes convidados não foram alteradas.")</p>
    </section>
    <section aria-labelledby="receipt-people-title">
        <h2 id="receipt-people-title" class="h4 mb-3">@T("Dados enviados")</h2>
        @foreach (var person in Model.People)
        {
            <article class="elegant-card p-4 mb-3 receipt-person">
                <h3 class="h5">@person.Name</h3>
                <partial name="_ReceiptPerson" model="person" />
                <p><strong>@T("Acompanhante:")</strong> @(person.Companion == null ? T("Sem acompanhante confirmado neste envio") : person.Companion.Name)</p>
                @if (person.Companion != null)
                {
                    <section class="receipt-companion" aria-label="@T("Dados do acompanhante de {0}", person.Name)">
                        <h4 class="h6">@T("Acompanhante:") @person.Companion.Name</h4>
                        <partial name="_ReceiptPerson" model="person.Companion" />
                    </section>
                }
            </article>
        }
    </section>
    <div class="elegant-card p-4 mt-4 receipt-actions">
        <h2 class="h5">@T("Guarda a tua confirmação")</h2>
        <p>@T("O recibo fica disponível neste navegador durante 24 horas. Podes imprimi-lo ou escolher «Guardar como PDF» na janela de impressão.")</p>
        <p>@T("Para corrigir uma resposta, volta a verificar o mesmo email. As alterações estão disponíveis até ao fim do prazo de RSVP.")</p>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" data-print-receipt><i class="bi bi-printer me-1" aria-hidden="true"></i> @T("Imprimir / guardar PDF")</button>
            <a class="btn btn-outline-primary" asp-action="Contact" asp-route-id="@Model.GuestId">@T("Alterar resposta")</a>
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">@T("Voltar ao início")</a>
        </div>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/pages/rsvp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/rsvp-receipt.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/rsvp-receipt.js" asp-append-version="true"></script>
}
