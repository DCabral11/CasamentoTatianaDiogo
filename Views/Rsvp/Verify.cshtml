@model RsvpCodeViewModel
@{
    ViewData["Title"] = "Introduzir código";
}
<section class="page-header">
    <div class="container"><h1><i class="bi bi-envelope-check" aria-hidden="true"></i> Introduzir código</h1><p>Falta um passo para aceder ao teu convite.</p></div>
</section>
<div class="container py-5 narrow">
    <form asp-action="Verify" method="post" class="elegant-card p-4">
        @Html.AntiForgeryToken()
        <p>Enviámos um código por email para <strong>@Model.MaskedContact</strong>.</p>
        <partial name="_FormErrors" />
        <label asp-for="Code" class="form-label">Código de verificação</label>
        <input asp-for="Code" class="form-control mb-2" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required aria-describedby="code-help" />
        <p id="code-help" class="form-text">O código tem 6 algarismos e é válido durante 10 minutos. Se pedires outro, usa o mais recente.</p>
        <button class="btn btn-primary rounded-pill">Verificar e continuar</button>
        <a asp-action="Contact" asp-route-id="@Model.GuestId" class="btn btn-link">Pedir novo código ou corrigir contacto</a>
    </form>
</div>
