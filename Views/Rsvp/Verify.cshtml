@model RsvpCodeViewModel
@{
    ViewData["Title"] = T("Introduzir código");
}
<section class="page-header">
    <div class="container"><h1><i class="bi bi-envelope-check" aria-hidden="true"></i> @T("Introduzir código")</h1><p>@T("Falta um passo para aceder ao teu convite.")</p></div>
