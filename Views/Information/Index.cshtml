@model InformationViewModel 
@{
    ViewData["Title"] = "Informações";

    var settings = Model.Settings;
}

<section class="page-header">
    <div class="container">
        <h1>
            <i class="bi bi-calendar-heart"></i> Informações
        </h1>

        <p>Tudo o que precisam de saber para o dia do casamento.</p>
    </div>
</section>

<section class="container py-5">
    <h2>Horário</h2>

    <div class="timeline">
        @foreach (var e in Model.TimelineEvents)
        {
            <div class="timeline-item">
                <div class="timeline-icon">
                    <i class="bi @e.IconName"></i>
                </div>
                <div>
                    <strong>@e.EventDateTime.ToString("HH:mm") - @e.Title</strong>
                    <p>@e.Description</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="elegant-card p-4 h-100">
                <h3>
                    <i class="bi bi-geo-alt"></i> Cerimónia
                </h3>
                <p>
                    <strong>@settings.CeremonyLocationName</strong>
                    <br/> @settings.CeremonyAddress
                </p>

                <a class="btn btn-outline-primary" href="@settings.CeremonyGoogleMapsUrl" target="_blank">
                    <i class="bi bi-map"></i> Google Maps
                </a>

                @if(!string.IsNullOrWhiteSpace(settings.CeremonyGoogleMapsEmbedUrl))
                {
                    <iframe class="map" src="@settings.CeremonyGoogleMapsEmbedUrl" loading="lazy"></iframe>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="elegant-card p-4 h-100">
                <h3>
                    <i class="bi bi-geo-alt"></i> Cerimónia
                </h3>
                <p>
                    <strong>@settings.ReceptionLocationName</strong>
                    <br /> @settings.ReceptionAddress
                </p>

                <a class="btn btn-outline-primary" href="@settings.ReceptionGoogleMapsUrl" target="_blank">
                    <i class="bi bi-map"></i> Google Maps
                </a>

                @if (!string.IsNullOrWhiteSpace(settings.ReceptionGoogleMapsEmbedUrl))
                {
                    <iframe class="map" src="@settings.ReceptionGoogleMapsEmbedUrl" loading="lazy"></iframe>
                }
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <h2>Contactos</h2>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="elegant-card p-4">
                <h4>@settings.BrideName</h4>
                <p>
                    <i class="bi bi-phone"></i> @settings.BridePhone <br/>
                    <i class="bi bi-envelope"></i> @settings.BrideEmail
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="elegant-card p-4">
                <h4>@settings.GroomName</h4>
                <p>
                    <i class="bi bi-phone"></i> @settings.GroomPhone <br />
                    <i class="bi bi-envelope"></i> @settings.GroomEmail
                </p>
            </div>
        </div>
    </div>
</section>