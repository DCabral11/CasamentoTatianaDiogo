@model InformationViewModel
@inject CasamentoTatianaDiogo.Services.Interfaces.ISiteContentService ContentTexts
@inject CasamentoTatianaDiogo.Services.WeddingClock Clock
@{
    ViewData["Title"] = T("Informações");

    var settings = Model.Settings;
    var calendarAvailable = Clock.EventStartUtc(settings.WeddingDateTime).HasValue;
    var ceremonyQuery = WeddingTravel.Address(settings.CeremonyLocationName, settings.CeremonyAddress);
    var receptionQuery = WeddingTravel.Address(settings.ReceptionLocationName, settings.ReceptionAddress);
    var texts = await ContentTexts.GetAsync();
    var travelLinks = new[] {
        (Topic: WeddingTravel.Parking, Label: T("Procurar parques perto da cerimónia"), Url: ceremonyQuery.Length == 0 ? null :
            "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(T("Estacionamento perto de ") + ceremonyQuery)),
        (Topic: WeddingTravel.Transport, Label: T("Ver percurso em transportes públicos"), Url: ceremonyQuery.Length == 0 ? null :
            "https://www.google.com/maps/dir/?api=1&travelmode=transit&destination=" + Uri.EscapeDataString(ceremonyQuery)),
        (Topic: WeddingTravel.Lodging, Label: T("Procurar alojamento perto da receção"), Url: receptionQuery.Length == 0 ? null :
            "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(T("Alojamento perto de ") + receptionQuery))
    };
    var ceremonyEmbedUrl = GetEmbedUrl(settings.CeremonyGoogleMapsEmbedUrl, $"https://www.google.com/maps?q={Uri.EscapeDataString(ceremonyQuery)}&output=embed");
    var receptionEmbedUrl = GetEmbedUrl(settings.ReceptionGoogleMapsEmbedUrl, $"https://www.google.com/maps?q={Uri.EscapeDataString(receptionQuery)}&output=embed");
    var arrival = Model.TimelineEvents.FirstOrDefault();
}

@functions {
    public static string GetEmbedUrl(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
            return fallback;

        var match = System.Text.RegularExpressions.Regex.Match(value, "src=[\\\"']([^\\\"']+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success ? System.Net.WebUtility.HtmlDecode(match.Groups[1].Value) : value;
    }
}

<div class="information-page">
<section class="page-header">
    <div class="container">
        <h1>
            <i class="bi bi-calendar-heart"></i> @T("Informações")
        </h1>

        <p>@T("Tudo o que precisam de saber para o dia do casamento.")</p>
    </div>
</section>

<section class="container information-essentials">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="information-tip h-100">
                <i class="bi bi-clock-history"></i>
                <div>
                    <h3>@T("Chegada")</h3>
                    <p>@T("Pedimos que cheguem até às") @(arrival?.EventDateTime.ToString("HH:mm") ?? T("horas indicadas")) @T("para aproveitarem o início da celebração.")</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="information-tip h-100">
                <i class="bi bi-envelope-check"></i>
                <div>
                    <h3>@T("Confirmação")</h3>
                    <p>@T("Indiquem a vossa presença e eventuais restrições alimentares com antecedência.")</p>
                    <a asp-controller="Rsvp" asp-action="Index">@T("Confirmar presença") <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container pt-5" aria-labelledby="travel-heading">
    <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between mb-4">
        <div>
            <h2 id="travel-heading">@T("Planear a visita")</h2>
            @if (calendarAvailable && settings.WeddingDateTime is DateTime date)
            {
                <p class="mb-0"><time datetime="@date.ToString("yyyy-MM-ddTHH:mm")">@date.ToString(DatePattern + " HH:mm", System.Globalization.CultureInfo.CurrentCulture)</time> @T("· Hora local")</p>
            }
            else
            {
                <p class="mb-0">@T("O evento ficará disponível no calendário quando a data e a hora estiverem definidas.")</p>
            }
        </div>
        @if (calendarAvailable)
        {
            <a class="btn btn-primary" asp-action="Calendar" download="casamento.ics"><i class="bi bi-calendar-plus" aria-hidden="true"></i> @T("Adicionar ao calendário (.ics)")</a>
        }
    </div>
    <div class="row g-3">
        @foreach (var link in travelLinks)
        {
            <div class="col-12 col-lg-4">
                <div class="elegant-card p-4 h-100">
                    <div class="location-card-heading">
                        <span class="location-marker" aria-hidden="true"><i class="bi @link.Topic.Icon"></i></span>
                        <h3 class="h5 mb-0">@T(link.Topic.Title)</h3>
                    </div>
                    <p class="travel-guidance">@texts.GetValueOrDefault(link.Topic.Key, T(link.Topic.DefaultText))</p>
                    @if (link.Url != null)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener">@link.Label <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden"> @T("(Google Maps, abre num novo separador)")</span></a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section class="container py-5 information-schedule">
    <div class="timeline">
        @foreach (var e in Model.TimelineEvents)
        {
            <div class="timeline-item">
                <div class="timeline-icon">
                    <i class="bi @e.IconName"></i>
                </div>
                <div class="timeline-content">
                    <time class="timeline-time">@e.EventDateTime.ToString("HH:mm")</time>
                    <h3>@e.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(e.Description))
                    {
                        <p>@e.Description</p>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section class="container py-5 information-locations">
    <h2>@T("Localizações")</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="elegant-card location-card p-4 h-100">
                <div class="location-card-heading"><span class="location-marker"><i class="bi bi-heart-fill"></i></span><h3>@T("Cerimónia")</h3></div>
                <p>
                    <strong>@settings.CeremonyLocationName</strong>
                    <br/> @settings.CeremonyAddress
                </p>

                <iframe class="map" src="@ceremonyEmbedUrl" title="@T("Mapa da cerimónia")" loading="lazy"></iframe>
            </div>
        </div>

        <div class="col-md-6">
            <div class="elegant-card location-card p-4 h-100">
                <div class="location-card-heading"><span class="location-marker"><i class="bi bi-fork-knife"></i></span><h3>@T("Copo D'Água")</h3></div>
                <p>
                    <strong>@settings.ReceptionLocationName</strong>
                    <br /> @settings.ReceptionAddress
                </p>

                <iframe class="map" src="@receptionEmbedUrl" title="@T("Mapa da receção")" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>

<section class="container py-4 information-contacts">
    <h2>@T("Contactos")</h2>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="elegant-card contact-card p-3 h-100">
                <div class="contact-card-heading"><i class="bi bi-person-heart"></i><h4>@settings.BrideName</h4></div>
                <div class="contact-details">
                    @if (CasamentoTatianaDiogo.Services.ContactFormats.Phone(settings.BridePhone, settings) is { } bridePhone) { <a href="@bridePhone.Link"><i class="bi bi-phone"></i><span>@bridePhone.Display</span></a> } else if (!string.IsNullOrWhiteSpace(settings.BridePhone)) { <span>@settings.BridePhone</span> }
                    @if (CasamentoTatianaDiogo.Services.ContactFormats.Email(settings.BrideEmail, settings) is { } brideEmail) { <a href="@brideEmail.Link"><i class="bi bi-envelope"></i><span>@brideEmail.Display</span></a> } else if (!string.IsNullOrWhiteSpace(settings.BrideEmail)) { <span>@settings.BrideEmail</span> }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="elegant-card contact-card p-3 h-100">
                <div class="contact-card-heading"><i class="bi bi-person-heart"></i><h4>@settings.GroomName</h4></div>
                <div class="contact-details">
                    @if (CasamentoTatianaDiogo.Services.ContactFormats.Phone(settings.GroomPhone, settings) is { } groomPhone) { <a href="@groomPhone.Link"><i class="bi bi-phone"></i><span>@groomPhone.Display</span></a> } else if (!string.IsNullOrWhiteSpace(settings.GroomPhone)) { <span>@settings.GroomPhone</span> }
                    @if (CasamentoTatianaDiogo.Services.ContactFormats.Email(settings.GroomEmail, settings) is { } groomEmail) { <a href="@groomEmail.Link"><i class="bi bi-envelope"></i><span>@groomEmail.Display</span></a> } else if (!string.IsNullOrWhiteSpace(settings.GroomEmail)) { <span>@settings.GroomEmail</span> }
                </div>
            </div>
        </div>
    </div>
</section>
</div>

@section Scripts {
    <script src="~/js/information-timeline.js" asp-append-version="true"></script>
}
