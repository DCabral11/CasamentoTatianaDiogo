@model InformationViewModel 
@{
    ViewData["Title"] = "Informações";

    var settings = Model.Settings;
    var ceremonyQuery = $"{settings.CeremonyLocationName}, {settings.CeremonyAddress}";
    var receptionQuery = $"{settings.ReceptionLocationName}, {settings.ReceptionAddress}";
    var ceremonyMapUrl = settings.CeremonyGoogleMapsUrl ?? $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(ceremonyQuery)}";
    var receptionMapUrl = settings.ReceptionGoogleMapsUrl ?? $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(receptionQuery)}";
    var ceremonyEmbedUrl = GetEmbedUrl(settings.CeremonyGoogleMapsEmbedUrl, $"https://www.google.com/maps?q={Uri.EscapeDataString(ceremonyQuery)}&output=embed");
    var receptionEmbedUrl = GetEmbedUrl(settings.ReceptionGoogleMapsEmbedUrl, $"https://www.google.com/maps?q={Uri.EscapeDataString(receptionQuery)}&output=embed");
    var arrival = Model.TimelineEvents.FirstOrDefault();
}

@functions {
    public static string GetEmbedUrl(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
            return fallback;

        var match = System.Text.RegularExpressions.Regex.Match(value, "src=[\\\"']([^\\\"']+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success ? System.Net.WebUtility.HtmlDecode(match.Groups[1].Value) : value;
    }
}

<div class="information-page">
<section class="page-header">
    <div class="container">
        <h1>
            <i class="bi bi-calendar-heart"></i> Informações
        </h1>

        <p>Tudo o que precisam de saber para o dia do casamento.</p>
    </div>
</section>

<section class="container information-essentials">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="information-tip h-100">
                <i class="bi bi-clock-history"></i>
                <div>
                    <h3>Chegada</h3>
                    <p>Pedimos que cheguem até às @(arrival?.EventDateTime.ToString("HH:mm") ?? "horas indicadas") para aproveitarem o início da celebração.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="information-tip h-100">
                <i class="bi bi-envelope-check"></i>
                <div>
                    <h3>Confirmação</h3>
                    <p>Indiquem a vossa presença e eventuais restrições alimentares com antecedência.</p>
                    <a asp-controller="Rsvp" asp-action="Index">Confirmar presença <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="information-tip h-100">
                <i class="bi bi-signpost-split"></i>
                <div>
                    <h3>Como chegar</h3>
                    <p>Guardem as localizações no telemóvel antes de sair.</p>
                    <a href="@ceremonyMapUrl" target="_blank" rel="noopener">Abrir rota <i class="bi bi-arrow-up-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5 information-schedule">
    <div class="timeline">
        @foreach (var e in Model.TimelineEvents)
        {
            <div class="timeline-item">
                <div class="timeline-icon">
                    <i class="bi @e.IconName"></i>
                </div>
                <div class="timeline-content">
                    <time class="timeline-time">@e.EventDateTime.ToString("HH:mm")</time>
                    <h3>@e.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(e.Description))
                    {
                        <p>@e.Description</p>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section class="container py-5 information-locations">
    <h2>Localizações</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="elegant-card location-card p-4 h-100">
                <div class="location-card-heading"><span class="location-marker"><i class="bi bi-heart-fill"></i></span><h3>Cerimónia</h3></div>
                <p>
                    <strong>@settings.CeremonyLocationName</strong>
                    <br/> @settings.CeremonyAddress
                </p>

                <iframe class="map" src="@ceremonyEmbedUrl" title="Mapa da cerimónia" loading="lazy"></iframe>
            </div>
        </div>

        <div class="col-md-6">
            <div class="elegant-card location-card p-4 h-100">
                <div class="location-card-heading"><span class="location-marker"><i class="bi bi-fork-knife"></i></span><h3>Copo D'Água</h3></div>
                <p>
                    <strong>@settings.ReceptionLocationName</strong>
                    <br /> @settings.ReceptionAddress
                </p>

                <iframe class="map" src="@receptionEmbedUrl" title="Mapa da receção" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>

<section class="container py-4 information-contacts">
    <h2>Contactos</h2>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="elegant-card contact-card p-3 h-100">
                <div class="contact-card-heading"><i class="bi bi-person-heart"></i><h4>@settings.BrideName</h4></div>
                <div class="contact-details">
                    @if (!string.IsNullOrWhiteSpace(settings.BridePhone)) { <a href="tel:@settings.BridePhone"><i class="bi bi-phone"></i><span>@settings.BridePhone</span></a> }
                    @if (!string.IsNullOrWhiteSpace(settings.BrideEmail)) { <a href="mailto:@settings.BrideEmail"><i class="bi bi-envelope"></i><span>@settings.BrideEmail</span></a> }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="elegant-card contact-card p-3 h-100">
                <div class="contact-card-heading"><i class="bi bi-person-heart"></i><h4>@settings.GroomName</h4></div>
                <div class="contact-details">
                    @if (!string.IsNullOrWhiteSpace(settings.GroomPhone)) { <a href="tel:@settings.GroomPhone"><i class="bi bi-phone"></i><span>@settings.GroomPhone</span></a> }
                    @if (!string.IsNullOrWhiteSpace(settings.GroomEmail)) { <a href="mailto:@settings.GroomEmail"><i class="bi bi-envelope"></i><span>@settings.GroomEmail</span></a> }
                </div>
            </div>
        </div>
    </div>
</section>
</div>

@section Scripts {
    <script src="~/js/information-timeline.js" asp-append-version="true"></script>
}
