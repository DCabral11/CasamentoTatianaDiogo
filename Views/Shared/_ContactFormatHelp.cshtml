@inject CasamentoTatianaDiogo.Services.Interfaces.IWeddingSettingsService ContactSettings
@{ var formats = await ContactSettings.GetAsync(); }
<p class="form-text">Números locais usam o país @formats.PhoneRegion. Para outro país, inclui o indicativo (por exemplo, +44). Podes acrescentar uma extensão, como «ext. 123».
@if (!string.IsNullOrEmpty(formats.DefaultEmailDomain)) { <span>Um email sem @@ será completado com @@<text>@formats.DefaultEmailDomain</text>.</span> }
</p>
