@using Microsoft.AspNetCore.Identity
@using CasamentoTatianaDiogo.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject CasamentoTatianaDiogo.Services.Interfaces.ISiteContentService SiteContent

@{
    var siteText = await SiteContent.GetAsync();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdminScreen = Context.Request.Path.StartsWithSegments("/Admin");
    var isAdminDashboard = Context.Request.Path.StartsWithSegments("/Admin/Dashboard");
}

<!DOCTYPE html>
<html lang="pt-PT">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width = device-width, initial-scale = 1" />

        <title>@ViewData["Title"] - Casamento Tatiana & Diogo</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        @if (isAdminScreen)
        {
            <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
        }
        @await RenderSectionAsync("Styles", required: false)
    </head>

    <body class="@(isAdminScreen ? "admin-screen" : "")">
        <a class="skip-link" href="#main-content">Saltar para o conteúdo</a>
        <nav class="navbar navbar-expand-lg navbar-light navbar-logo-bg shadow-sm sticky-top" aria-label="Navegação principal">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="@siteText.GetValueOrDefault("NavHome", "Início")" aria-current="@(currentController == "Home" && Equals(ViewContext.RouteData.Values["action"], "Index") ? "page" : null)">
                    <img src="/images/navbar.png" class="nav-logo" alt="Tatiana & Diogo Logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Menu principal">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="nav" class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rsvp" asp-action="Index" aria-current="@(currentController == "Rsvp" ? "location" : null)">@siteText.GetValueOrDefault("NavRsvp", "Confirmar presença")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Information" asp-action="Index" aria-current="@(currentController == "Information" ? "location" : null)">@siteText.GetValueOrDefault("NavInformation", "Informações")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Photos" asp-action="Index" aria-current="@(currentController == "Photos" ? "location" : null)">@siteText.GetValueOrDefault("NavPhotos", "Enviar fotografias")</a>
                        </li>
                        @if (isAdminScreen && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@(isAdminDashboard ? "/" : "/Admin/Dashboard/Index")">
                                    <i class="bi bi-arrow-left"></i>
                                    @(isAdminDashboard ? "Voltar ao site" : "Voltar ao painel")
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <main id="main-content" tabindex="-1">
            @if (TempData["Success"] != null)
            {
                <div class="container mt-3">
                    <div class="feedback-card feedback-card-success" role="status">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="container mt-3">
                    <div class="feedback-card feedback-card-error" role="alert">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="py-5 text-center text-muted">
            @siteText.GetValueOrDefault("FooterText", "Feito com amor por Diogo") <i class="bi bi-heart-fill text-danger"></i>
            <div class="mt-2"><a class="small text-muted" href="/Admin/Dashboard/Index">Administração</a></div>
        </footer> 

        @if (isAdminScreen)
        {
            <div class="modal fade" id="delete-confirmation-modal" tabindex="-1" aria-labelledby="delete-confirmation-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content delete-confirmation-card">
                        <div class="modal-body text-center p-4 p-md-5">
                            <span class="delete-confirmation-icon" aria-hidden="true"><i class="bi bi-trash3"></i></span>
                            <p class="delete-confirmation-label">Eliminar registo</p>
                            <h2 id="delete-confirmation-title">Confirmar eliminação?</h2>
                            <p class="delete-confirmation-message mb-0" data-delete-confirmation-message>Esta ação não pode ser anulada.</p>
                        </div>
                        <div class="modal-footer justify-content-center border-0 pt-0 pb-4 px-4 px-md-5 gap-2">
                            <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Manter registo</button>
                            <button type="button" class="btn btn-danger" data-delete-confirmation-accept><i class="bi bi-trash3 me-1"></i> Eliminar</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @if (isAdminScreen)
        {
            <script src="~/js/admin-delete-confirmation.js" asp-append-version="true"></script>
        }

        @await RenderSectionAsync("Scripts", required: false)
        <script src="~/js/form-feedback.js" asp-append-version="true"></script>
    </body>
</html>
