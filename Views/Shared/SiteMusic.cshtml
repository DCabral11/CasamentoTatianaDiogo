@using Microsoft.AspNetCore.WebUtilities
@inject CasamentoTatianaDiogo.Services.SiteThemeService SiteTheme
@{
    Layout = null;
    var theme = await SiteTheme.GetAsync();
    var track = (string)ViewData["SpotifyTrack"]!;
    var guestUrl = QueryHelpers.AddQueryString(Context.Request.QueryString.Value ?? "", "sitePage", "1");
}
<!doctype html>
<html lang="pt-PT" data-bs-theme="@theme.Mode" style="@theme.Variables">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Casamento Tatiana &amp; Diogo</title>
    <link rel="stylesheet" href="~/css/pages/site-music.css" asp-append-version="true" />
</head>
<body>
    <a class="music-skip" href="#music-controls">Ir para os controlos de música</a>
    <iframe id="guest-page" title="Site do casamento" src="@guestUrl"></iframe>
    <aside id="music-controls" aria-label="Música do casamento" tabindex="-1">
        <div id="music-player" data-track="@track">
            <a href="@track" target="_blank" rel="noopener">Ouvir no Spotify</a>
        </div>
    </aside>
    <script src="~/js/site-music.js" asp-append-version="true"></script>
</body>
</html>
