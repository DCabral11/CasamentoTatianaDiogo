@model IEnumerable<SiteContent>
@{ ViewData["Title"] = T("Textos do site"); }
<div class="container py-5">
    <h1>@T("Textos do site")</h1>
    <p><a asp-action="Travel">@T("Gerir estacionamento, transportes e alojamento")</a></p>
    <partial name="_AdminFilters" />
    <p class="text-muted">@T("Edita os textos do design sem alterar código.")</p>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>@T("Área")</th><th>@T("Texto atual")</th><th></th></tr></thead><tbody>
    @foreach (var content in Model) { <tr><td>@content.Description</td><td class="text-truncate" style="max-width: 460px">@content.Value</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@content.Id">@T("Editar")</a></td></tr> }
    </tbody></table></div>
</div>
