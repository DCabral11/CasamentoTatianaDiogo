@model IEnumerable<SiteContent>
@{ ViewData["Title"] = "Textos do site"; }
<div class="container py-5">
    <h1>Textos do site</h1>
    <p class="text-muted">Edita os textos do design sem alterar código.</p>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Área</th><th>Texto atual</th><th></th></tr></thead><tbody>
    @foreach (var content in Model) { <tr><td>@content.Description</td><td class="text-truncate" style="max-width: 460px">@content.Value</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@content.Id">Editar</a></td></tr> }
    </tbody></table></div>
</div>
