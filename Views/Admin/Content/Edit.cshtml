@model SiteContent
@{ ViewData["Title"] = T("Editar texto"); }
<div class="container py-5 narrow">
    <h1>@T("Editar texto")</h1><p class="text-muted">@Model.Description</p>
    <form method="post" asp-action="Save" class="admin-form">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Key" type="hidden" /><input asp-for="Description" type="hidden" /><input asp-for="IsHtml" type="hidden" />
        <partial name="_FormErrors" />
        <label asp-for="Value" class="form-label">@T("Texto")</label><textarea asp-for="Value" class="form-control" rows="6"></textarea><span asp-validation-for="Value" class="text-danger"></span>
        <div class="admin-form-actions">
            <button class="btn btn-primary">@T("Guardar texto")</button>
            <a class="btn btn-link" asp-action="Index">@T("Cancelar")</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
