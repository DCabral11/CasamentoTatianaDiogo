@model CasamentoTatianaDiogo.ViewModels.Admin.DashboardViewModel
@{
    ViewData["Title"] = "Painel de administração";
}

<div class="container py-5">
    <h1>Painel de administração</h1>
    <p class="text-muted">Acompanhe as confirmações e atualize todos os conteúdos do site.</p>
    <div class="admin-grid">
        <div class="stat">
            @Model.GuestCount
            <small>Convidados</small>
        </div>
        <div class="stat">
            @Model.Attending
            <small>Confirmados</small>
        </div>
        <div class="stat">
            @Model.NotAttending
            <small>Não vão estar presentes</small>
        </div>
        <div class="stat">
            @Model.Pending
            <small>Por responder</small>
        </div>
        <div class="stat">
            @Model.UploadedPhotos
            <small>Fotografias</small>
        </div>
    </div>

    <div class="list-group mt-4">
        <a class="list-group-item" href="/Admin/Settings/Index"><i class="bi bi-sliders"></i> Dados e conteúdos do casamento</a>
        <a class="list-group-item" href="/Admin/Timeline/Index"><i class="bi bi-clock-history"></i> Horário do dia</a>
        <a class="list-group-item" href="/Admin/Guests/Index"><i class="bi bi-people"></i> Convidados</a>
        <a class="list-group-item" href="/Admin/InvitationGroups/Index"><i class="bi bi-collection"></i> Famílias</a>
        <a class="list-group-item" href="/Admin/PlusOnes/Index"><i class="bi bi-person-plus"></i> Acompanhantes</a>
        <a class="list-group-item" href="/Admin/Rsvp/Index"><i class="bi bi-envelope-check"></i> Respostas de presença</a>
        <a class="list-group-item" href="/Admin/Photos/Settings"><i class="bi bi-camera"></i> Definições da galeria</a>
        <a class="list-group-item" href="/Admin/Photos/Index"><i class="bi bi-images"></i> Fotografias recebidas</a>
    </div>
</div>
