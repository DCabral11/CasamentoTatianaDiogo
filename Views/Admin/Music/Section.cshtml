@model MusicSection
@{
    ViewData["Title"] = Model.Id == 0 ? T("Adicionar secção") : T("Editar secção");
}
<div class="container py-5 narrow">
    <a asp-action="Index">@T("Voltar ao programa musical")</a>
    <h1 class="mt-3">@ViewData["Title"]</h1>
    <form asp-action="SaveSection" method="post" class="admin-form">
        <input asp-for="Id" type="hidden" /><partial name="_FormErrors" />
        <div class="mb-3"><label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="100" required /></div>
        <div class="mb-3"><label asp-for="DisplayOrder" class="form-label">@T("Ordem no programa")</label>
            <input asp-for="DisplayOrder" class="form-control" min="1" max="9999" required aria-describedby="order-help" />
            <small id="order-help">@T("Os números mais baixos aparecem primeiro.")</small></div>
        <div class="admin-form-actions">
            <button class="btn btn-primary">@T("Guardar secção")</button>
            <a class="btn btn-link" asp-action="Index">@T("Cancelar")</a>
        </div>
    </form>
    @if (Model.Id != 0)
    {
        <form method="post" asp-action="DeleteSection" asp-route-id="@Model.Id" class="mt-4"
              data-delete-confirmation data-delete-message="@T("Eliminar a secção «{0}»?", Model.Name)">
            <button class="btn btn-outline-danger">@T("Eliminar secção")</button>
            <small class="d-block mt-1">@T("Apenas podes eliminar secções vazias.")</small>
        </form>
    }
</div>
