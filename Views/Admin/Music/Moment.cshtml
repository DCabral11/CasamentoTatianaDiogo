@model MusicMoment
@{
    ViewData["Title"] = Model.Id == 0 ? "Adicionar momento" : "Editar momento";
}
<div class="container py-5 narrow">
    <a asp-action="Index" asp-fragment="seccao-@Model.SectionId">Voltar ao programa musical</a>
    <h1 class="mt-3">@ViewData["Title"]</h1>
    <form asp-action="SaveMoment" method="post" class="admin-form">
        <input asp-for="Id" type="hidden" /><partial name="_FormErrors" />
        <div class="mb-3"><label asp-for="SectionId" class="form-label"></label>
            <select asp-for="SectionId" asp-items="ViewBag.Sections" class="form-select" required></select></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="150" required /></div>
        <div class="mb-3"><label asp-for="Song" class="form-label">Música (opcional)</label>
            <input asp-for="Song" class="form-control" maxlength="250" aria-describedby="song-help" />
            <small id="song-help">Deixa em branco se a música ainda estiver por definir.</small></div>
        <div class="mb-3"><label asp-for="DisplayOrder" class="form-label">Ordem nesta secção</label>
            <input asp-for="DisplayOrder" class="form-control" min="1" max="9999" required aria-describedby="order-help" />
            <small id="order-help">Os números mais baixos aparecem primeiro.</small></div>
        <button class="btn btn-primary">Guardar momento</button> <a class="btn btn-link" asp-action="Index" asp-fragment="seccao-@Model.SectionId">Cancelar</a>
    </form>
    @if (Model.Id != 0)
    {
        <form method="post" asp-action="DeleteMoment" asp-route-id="@Model.Id" class="mt-4"
              data-delete-confirmation data-delete-message="Eliminar o momento «@Model.Name» do programa?">
            <button class="btn btn-outline-danger">Eliminar momento</button>
        </form>
    }
</div>
