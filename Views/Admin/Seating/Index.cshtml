@model CasamentoTatianaDiogo.ViewModels.Admin.SeatingPlan
@{
    ViewData["Title"] = T("Plano de mesas");
    var capacity = Model.Tables.Sum(t => t.Seats.Count);
}
<div class="container py-5">
    <h1>@T("Plano de mesas")</h1>
    <div class="admin-page-actions">
        <a asp-action="Table" class="btn btn-primary">@T("Adicionar mesa")</a>
        <a asp-action="Map" class="btn btn-outline-primary">@T("Mapa da sala")</a>
        <a asp-action="Print" class="btn btn-outline-primary">@T("Lista por mesa")</a>
        <a asp-action="Print" asp-route-alphabetical="true" class="btn btn-outline-primary">@T("Lista alfabética")</a>
    </div>
    <section aria-labelledby="tables-heading" class="my-4">
        <h2 id="tables-heading">@T("Mesas e capacidade")</h2>
        @if (Model.Tables.Count == 0)
        {
            <p>@T("Adiciona a primeira mesa para começar a distribuir os lugares.")</p>
        }
        else
        {
            <p>@Model.Places.Count @T("de") @capacity @T("lugares ocupados ·") @(capacity - Model.Places.Count) @T("livres")</p>
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>@T("Mesa")</th><th>@T("Ocupados")</th><th>@T("Capacidade")</th><th>@T("Livres")</th><th>@T("Posição no mapa")</th><th></th></tr></thead>
                <tbody>
                @foreach (var table in Model.Tables)
                {
                    var occupied = table.Seats.Count(s => s.Assignment != null);
                    <tr><th scope="row">@table.Name</th><td>@occupied</td><td>@table.Seats.Count</td><td>@(table.Seats.Count - occupied)</td>
                        <td>@T("Fila") @table.MapRow @T("· Coluna") @table.MapColumn</td>
                        <td><a asp-action="Table" asp-route-id="@table.Id" aria-label="@T("Editar mesa {0}", table.Name)">@T("Editar")</a></td></tr>
                }
                </tbody>
            </table></div>
        }
    </section>
    <section aria-labelledby="seating-guests">
        <h2 id="seating-guests">@T("Distribuir lugares")</h2>
        <p>@Model.Guests.Count(g => g.Status == CasamentoTatianaDiogo.Models.Enums.RsvpStatus.Attending && !Model.Places.ContainsKey(g.Id)) @T("convidados com presença confirmada ainda sem lugar.")</p>
        @if (Model.Guests.Count > 0)
        {
            <div class="mb-3" hidden id="seat-search-box">
                <label for="seat-search" class="form-label">@T("Pesquisar por convidado ou família")</label>
                <input type="search" id="seat-search" class="form-control" />
            </div>
            <div class="table-responsive"><table class="table align-middle">
                <thead><tr><th>@T("Convidado")</th><th>@T("Família")</th><th>@T("RSVP")</th><th>@T("Lugar")</th><th></th></tr></thead>
                <tbody id="seating-guests-list">
                @foreach (var guest in Model.Guests)
                {
                    var place = Model.Places.GetValueOrDefault(guest.Id);
                    <tr data-name="@guest.Name @guest.Family"><th scope="row">@guest.Name @if (guest.IsPlusOne) { <small>@T("(acompanhante)")</small> }</th>
                        <td>@guest.Family</td><td>@guest.Response</td><td>@(place ?? T("Sem lugar"))</td>
                        <td><a asp-action="Guest" asp-route-id="@guest.Id" aria-label="@T("Gerir lugar de {0}", guest.Name)">@(place == null ? T("Atribuir lugar") : T("Alterar lugar"))</a></td></tr>
                }
                </tbody>
            </table></div>
            <p id="seat-no-match" role="status" hidden>@T("Nenhum convidado corresponde à pesquisa.")</p>
        }
    </section>
</div>
@section Scripts { <script src="~/js/seating.js" asp-append-version="true"></script> }
