@model CasamentoTatianaDiogo.ViewModels.Admin.GuestSeatForm
@{ ViewData["Title"] = T("Lugar do convidado"); }
<div class="container py-5 narrow">
    <h1>@T("Lugar de") @Model.Guest.Name</h1>
    <p>@Model.Guest.Family · @Model.Guest.Response</p>
    <form method="post" asp-action="Assign" asp-route-id="@Model.Guest.Id" class="admin-form">
        <input name="originalSeatId" type="hidden" value="@Model.OriginalSeatId" />
        <label for="seat-id" class="form-label">@T("Mesa e lugar")</label>
        <select class="form-select mb-3" name="seatId" id="seat-id" required>
            <option value="0" selected="@(Model.OriginalSeatId == 0)">@T("Sem lugar atribuído")</option>
            @foreach (var group in Model.Options.GroupBy(s => new { s.Table, s.Row, s.Column }))
            {
                <optgroup label="@T("{0} · Fila {1}, coluna {2}", group.Key.Table, group.Key.Row, group.Key.Column)">@foreach (var seat in group) {
                    <option value="@seat.Id" selected="@(seat.Id == Model.OriginalSeatId)">@seat.Table @T("· Lugar") @seat.Number</option>
                }</optgroup>
            }
        </select>
        @if (Model.Options.All(s => s.Id == Model.OriginalSeatId))
        {
            <p>@T("Não há outros lugares livres. Podes") <a asp-action="Table">@T("adicionar uma mesa")</a> @T("ou aumentar a capacidade de uma mesa existente.")</p>
        }
        <div class="admin-form-actions">
            <button class="btn btn-primary" type="submit">@T("Guardar lugar")</button>
            <a asp-action="Index" class="btn btn-link">@T("Voltar ao plano")</a>
        </div>
    </form>
</div>
