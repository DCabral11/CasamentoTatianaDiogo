@model IEnumerable<PhotoUpload>

<div class="container py-5">
    <h1>@T("Fotografias recebidas")</h1>
    <partial name="_AdminFilters" />
    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>@T("Data")</th>
                <th>@T("Ficheiro")</th>
                <th>@T("Convidado")</th>
                <th>@T("Tamanho")</th>
                <th>@T("Google Drive")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var p in Model)
            {
                <tr>
                    <th>@p.UploadedAt</th>
                    <th>@p.OriginalFileName</th>
                    <th>@p.GuestName</th>
                    <th>@p.SizeBytes</th>
                    <td>
                        <a href="@p.GoogleDriveWebViewLink" target="_blank" rel="noopener">@T("Abrir")</a>
                    </td>
                    <td>
                        <form method="post" action="/Admin/Photos/Delete/@p.Id" data-delete-confirmation data-delete-message="@T("Queres mesmo remover o registo desta fotografia? O ficheiro guardado no Drive não será apagado.")">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash3"></i> @T("Remover registo")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
