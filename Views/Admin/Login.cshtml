@{
    Layout = "_Layout";
    ViewData["Title"] = "Área de administração";
}

<div class="container py-5 narrow">
    <form method="post" class="elegant-card p-4">
        @Html.AntiForgeryToken()
        <h1>Área de administração</h1>
        <p class="text-muted">Inicia sessão para gerir o site do casamento.</p>
        <partial name="_FormErrors" />
        <label for="login-email" class="form-label">Email</label>
        <input id="login-email" required autocomplete="username" name="email" type="email" class="form-control mb-3" />
        <label for="login-password" class="form-label">Palavra-passe</label>
        <input id="login-password" required autocomplete="current-password" name="password" type="password" class="form-control mb-3" />
        <button class="btn btn-primary">Entrar</button>
    </form>
</div>
