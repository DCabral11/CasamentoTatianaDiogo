@model IEnumerable<PlusOne>
@{
    ViewData["Title"] = "Acompanhantes";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="mb-1">Acompanhantes</h1><p class="text-muted mb-0">Gere os Plus One associados a cada convidado.</p></div>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Adicionar acompanhante</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Acompanhante</th><th>Convidado associado</th><th>Restrições alimentares</th><th class="text-end">Ações</th></tr></thead>
            <tbody>
            @foreach (var plusOne in Model)
            {
                <tr>
                    <td>@plusOne.PlusOneDisplayName</td><td>@plusOne.MainGuest?.DisplayName</td><td>@(plusOne.PlusOneDietaryRestrictions ?? "—")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@plusOne.Id">Editar</a>
                        <form method="post" asp-action="Delete" asp-route-id="@plusOne.Id" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Remover este acompanhante?')">Remover</button></form></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
