@model Family
@{
    ViewData["Title"] = Model.Id == 0 ? T("Adicionar família") : T("Editar família");
}
<div class="container py-5 narrow">
    <h1>@ViewData["Title"]</h1><p class="text-muted">@T("Organiza convidados que pertencem ao mesmo agregado.")</p>
    <form method="post" action="/Admin/InvitationGroups/Save" class="admin-form">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><partial name="_FormErrors" />
        <input asp-for="RsvpVersion" type="hidden" />
        @if (Context.Response.StatusCode == 409)
        {
            <p><a asp-action="Edit" asp-route-id="@Model.Id">@T("Abrir a versão mais recente do convite")</a> @T("(os campos abaixo mantêm os dados que tentaste guardar).")</p>
        }
        <div class="mb-3"><label asp-for="Name" class="form-label">@T("Nome da família")</label><input asp-for="Name" class="form-control" placeholder="@T("Ex.: Família Silva")" /></div>
        <div class="mb-3"><label asp-for="GroupCode" class="form-label">@T("Nome de referência")</label><input asp-for="GroupCode" aria-describedby="family-reference-help" class="form-control" placeholder="@T("Ex.: Colegas do trabalho")" /><div class="form-text" id="family-reference-help">@T("Uso interno para distinguir famílias com o mesmo nome. Este nome aparece ao escolher a família de um convidado.")</div></div>
        <div class="form-check mb-3"><input asp-for="AllowGroupRsvp" class="form-check-input" /><label asp-for="AllowGroupRsvp" class="form-check-label">@T("Permitir respostas por vários membros da família")</label></div>
        <div class="mb-3"><label asp-for="Notes" class="form-label">@T("Notas internas")</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
        <div class="admin-form-actions">
            <button class="btn btn-primary">@T("Guardar família")</button>
            <a class="btn btn-link" href="/Admin/InvitationGroups/Index">@T("Cancelar")</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
