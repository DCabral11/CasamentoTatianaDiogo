@model Family

<div class="container py-5 narrow">
    <h1>Edit Family</h1>
    <form method="post" action="/Admin/InvitationGroups/Save">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input name="Name" value="@Model.Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">GroupCode</label>
            <input name="GroupCode" value="@Model.GroupCode" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">AllowGroupRsvp</label>
            <input name="AllowGroupRsvp" value="@Model.AllowGroupRsvp" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Notes</label>
            <input name="Notes" value="@Model.Notes" class="form-control" />
        </div>
        <button class="btn btn-primary">Save</button>
    </form>
</div>