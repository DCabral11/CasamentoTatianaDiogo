@model IEnumerable<Family>

<div class="container py-5">
    <h1>@T("Famílias")</h1>
    <div class="admin-page-actions">
        <a class="btn btn-primary" href="/Admin/InvitationGroups/Create"><i class="bi bi-plus-lg"></i> @T("Adicionar família")</a>
        <a class="btn btn-outline-primary" asp-controller="ExcelImport" asp-action="Families"><i class="bi bi-file-earmark-arrow-up"></i> @T("Importar Excel")</a>
    </div>
    <partial name="_AdminFilters" />
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@T("Id")</th>
                <th>@T("Nome")</th>
                <th>@T("Nome de referência")</th>
                <th>@T("Respostas múltiplas")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.GroupCode</td>
                    <td>@item.AllowGroupRsvp</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="/Admin/InvitationGroups/Edit/@item.Id"><i class="bi bi-pencil-square"></i> @T("Editar")</a>
                        <form method="post" action="/Admin/InvitationGroups/Delete/@item.Id" class="d-inline" data-delete-confirmation data-delete-message="@T("Queres mesmo eliminar a família «{0}»? Esta ação não pode ser anulada.", item.Name)">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i> @T("Remover")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
