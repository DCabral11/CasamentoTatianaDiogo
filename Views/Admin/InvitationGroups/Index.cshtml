@model IEnumerable<Family>

<div class="container py-5">
    <h1>Famílias</h1>
    <p>
        <a class="btn btn-primary" href="/Admin/InvitationGroups/Create">Adicionar família</a>
    </p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Nome de referência</th>
                <th>Respostas múltiplas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.GroupCode</td>
                    <td>@item.AllowGroupRsvp</td>
                    <td>
                        <a href="/Admin/InvitationGroups/Edit/@item.Id">Editar</a>
                        <form method="post" action="/Admin/InvitationGroups/Delete/@item.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-link text-danger" onclick="return confirm('Remover esta família?')">Remover</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
