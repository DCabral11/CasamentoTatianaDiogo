@model CasamentoTatianaDiogo.ViewModels.Admin.ImportPreviewViewModel
@{ ViewData["Title"] = "Corrigir dados da importação"; }
<div class="container py-5">
    <h1>Corrigir dados da importação</h1>
    <p>Estas alterações atualizam apenas a pré-visualização. No passo seguinte poderás rever novamente os dados antes de importar.</p>
    <form asp-action="Review" method="post">
        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="revision" value="@Model.Revision" />
        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var row = Model.Rows[i];
            <fieldset class="elegant-card p-4 mb-4">
                <legend class="h5">Linha @row.Number</legend>
                <input type="hidden" name="Rows[@i].Number" value="@row.Number" />
                @if (Model.Plan[i].Errors.Count > 0)
                {
                    <ul class="text-danger">@foreach (var error in Model.Plan[i].Errors) { <li>@error</li> }</ul>
                }
                <div class="row g-3">
                    @for (var c = 0; c < Model.Columns.Length; c++)
                    {
                        var column = Model.Columns[c];
                        var inputId = $"row-{i}-field-{c}";
                        <div class="col-12 col-md-6 col-lg-4">
                            <label for="@inputId" class="form-label">@column</label>
                            @if (column == "Notas")
                            {
                                <textarea id="@inputId" name="Rows[@i].Values[@column]" class="form-control" rows="3" maxlength="1000">@row.Values.GetValueOrDefault(column)</textarea>
                            }
                            else
                            {
                                <input id="@inputId" name="Rows[@i].Values[@column]" value="@row.Values.GetValueOrDefault(column)" class="form-control" maxlength="2000" />
                            }
                        </div>
                    }
                </div>
            </fieldset>
        }
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit">Validar e rever pré-visualização</button>
            <a class="btn btn-outline-primary" asp-action="Preview" asp-route-id="@Model.Id">Voltar sem guardar correções</a>
        </div>
    </form>
</div>
