@model CasamentoTatianaDiogo.ViewModels.Admin.ImportPreviewViewModel
@using CasamentoTatianaDiogo.Services
@{
    ViewData["Title"] = T("Corrigir dados da importação");
    var errors = Model.Plan.Where(row => row.Errors.Count > 0).ToDictionary(row => row.Number, row => row.Errors);
    var rows = Model.Rows.Where(row => errors.ContainsKey(row.Number)).ToList();
}
<div class="container py-5">
    <h1>@T("Corrigir dados da importação")</h1>
    <p>@T("Corrige as linhas indicadas. No passo seguinte podes rever a importação completa antes de confirmar.")</p>
    <form asp-action="Review" method="post">
        <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="revision" value="@Model.Revision" />
        @for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            <fieldset class="elegant-card p-4 mb-4">
                <legend class="h5">@T("Linha") @row.Number</legend>
                <input type="hidden" name="Rows[@i].Number" value="@row.Number" />
                <ul class="text-danger">@foreach (var error in errors[row.Number]) { <li>@error</li> }</ul>
                <div class="row g-3">
                    @for (var c = 0; c < Model.Columns.Length; c++)
                    {
                        var column = Model.Columns[c];
                        var inputId = $"row-{i}-field-{c}";
                        <div class="col-12 col-md-6 col-lg-4">
                            @if (ExcelImportService.IsBooleanColumn(column))
                            {
                                var choice = ExcelImportService.BooleanChoice(row.Values.GetValueOrDefault(column, ""), column);
                                <fieldset>
                                    <legend class="form-label fs-6">@T(column)</legend>
                                    @foreach (var option in new[] { "Sim", "Não" })
                                    {
                                        var optionId = inputId + (option == "Sim" ? "-yes" : "-no");
                                        <div class="form-check form-check-inline">
                                            <input id="@optionId" type="radio" class="form-check-input" name="Rows[@i].Values[@column]" value="@option" required checked="@(choice == (option == "Sim"))" />
                                            <label for="@optionId" class="form-check-label">@T(option)</label>
                                        </div>
                                    }
                                </fieldset>
                            }
                            else
                            {
                                <label for="@inputId" class="form-label">@T(column)</label>
                                @if (column == "Notas")
                                {
                                    <textarea id="@inputId" name="Rows[@i].Values[@column]" class="form-control" rows="3" maxlength="1000">@row.Values.GetValueOrDefault(column)</textarea>
                                }
                                else
                                {
                                    <input id="@inputId" name="Rows[@i].Values[@column]" value="@row.Values.GetValueOrDefault(column)" class="form-control" maxlength="2000" />
                                }
                            }
                        </div>
                    }
                </div>
            </fieldset>
        }
        <div class="admin-form-actions">
            <button class="btn btn-primary" type="submit">@T("Validar e rever pré-visualização")</button>
            <a class="btn btn-outline-primary" asp-action="Preview" asp-route-id="@Model.Id">@T("Voltar sem guardar correções")</a>
        </div>
    </form>
</div>
