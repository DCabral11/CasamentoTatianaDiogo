@inject CasamentoTatianaDiogo.Services.Interfaces.IWeddingSettingsService ContactSettings
@using CasamentoTatianaDiogo.Services
@{ var formats = await ContactSettings.GetAsync(); }
@model IEnumerable<Guest>

<div class="container py-5">
    <h1>@T("Convidados")</h1>
    <div class="admin-page-actions">
        <a class="btn btn-primary" href="/Admin/Guests/Create"><i class="bi bi-person-plus"></i> @T("Adicionar convidado")</a>
        <a class="btn btn-outline-primary" asp-controller="ExcelImport" asp-action="Guests"><i class="bi bi-file-earmark-arrow-up"></i> @T("Importar Excel")</a>
        <a class="btn btn-outline-primary" href="@(Url.Action("ExportCsv") + Context.Request.QueryString)">@T("Exportar CSV (filtros atuais)")</a>
    </div>
    <partial name="_AdminFilters" />
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@T("Id")</th>
                <th>@T("Avatar")</th>
                <th>@T("Nome")</th>
                <th>@T("Acompanhante")</th>
                <th>@T("E-mail")</th>
                <th>@T("Telefone")</th>
                <th>@T("Resposta")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><span class="guest-avatar admin-guest-avatar" style="--avatar-scale:@item.AvatarScale.ToString(System.Globalization.CultureInfo.InvariantCulture);--avatar-position-x:@item.AvatarPositionX%;--avatar-position-y:@item.AvatarPositionY%;">@if (!string.IsNullOrWhiteSpace(item.AvatarFileName)) { <img src="@($"/images/guests/{System.Uri.EscapeDataString(item.AvatarFileName)}")" alt="" /> } else { <i class="bi bi-person-heart"></i> }</span></td>
                    <td>@item.DisplayName</td>
                    <td>@if (item.IsPlusOne) { <span>@T("Plus-One de") <a asp-action="Edit" asp-route-id="@item.MainGuestId">@item.MainGuest?.DisplayName</a></span> } else { <span>@(item.AllowPlusOne ? T("Pode levar acompanhante") : "—")</span> }</td>
                    <td>@(ContactFormats.Email(item.Email, formats)?.Display ?? item.Email)</td>
                    <td>@(ContactFormats.Phone(item.Phone, formats)?.Display ?? item.Phone)</td>
                    <td>@(item.CurrentStatus switch { CasamentoTatianaDiogo.Models.Enums.RsvpStatus.Attending => T("Vai estar presente"), CasamentoTatianaDiogo.Models.Enums.RsvpStatus.NotAttending => T("Não vai estar presente"), _ => T("Por responder") })</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="/Admin/Guests/Edit/@item.Id"><i class="bi bi-pencil-square"></i> @T("Editar")</a>
                        <form method="post" action="/Admin/Guests/Delete/@item.Id" class="d-inline" data-delete-confirmation data-delete-message="@T("Queres mesmo eliminar o convidado «{0}»? Esta ação não pode ser anulada.", item.DisplayName)">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i> @T("Remover")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
