@model IEnumerable<Guest>

<div class="container py-5">
    <h1>Convidados</h1>
    <p>
        <a class="btn btn-primary" href="/Admin/Guests/Create">Adicionar convidado</a>
    </p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Avatar</th>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Telefone</th>
                <th>Resposta</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><span class="guest-avatar admin-guest-avatar" style="--avatar-scale:@item.AvatarScale.ToString(System.Globalization.CultureInfo.InvariantCulture);--avatar-position-x:@item.AvatarPositionX%;--avatar-position-y:@item.AvatarPositionY%;">@if (!string.IsNullOrWhiteSpace(item.AvatarFileName)) { <img src="@($"/images/guests/{System.Uri.EscapeDataString(item.AvatarFileName)}")" alt="" /> } else { <i class="bi bi-person-heart"></i> }</span></td>
                    <td>@item.DisplayName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.CurrentStatus</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="/Admin/Guests/Edit/@item.Id"><i class="bi bi-pencil-square"></i> Editar</a>
                        <form method="post" action="/Admin/Guests/Delete/@item.Id" class="d-inline" data-delete-confirmation data-delete-message="Queres mesmo eliminar o convidado «@item.DisplayName»? Esta ação não pode ser anulada.">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i> Remover</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
