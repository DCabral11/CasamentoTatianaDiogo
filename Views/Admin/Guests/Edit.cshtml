@model Guest
@{
    ViewData["Title"] = Model.Id == 0 ? "Adicionar convidado" : "Editar convidado";
}
<div class="container py-5 narrow">
    <h1>@ViewData["Title"]</h1><p class="text-muted">Define os dados de contacto e as opções de resposta deste convidado.</p>
    <form method="post" action="/Admin/Guests/Save" class="admin-form">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><partial name="_FormErrors" />
        <div class="mb-3"><label asp-for="FamilyId" class="form-label">Família</label><select asp-for="FamilyId" asp-items="ViewBag.Families" class="form-select"><option value="">Seleciona uma família</option></select></div>
        <div class="row g-3"><div class="col-md-6"><label asp-for="FirstName" class="form-label">Primeiro nome</label><input asp-for="FirstName" class="form-control" /></div><div class="col-md-6"><label asp-for="LastName" class="form-label">Apelido</label><input asp-for="LastName" class="form-control" /></div></div>
        <div class="mt-3"><label asp-for="DisplayName" class="form-label">Nome a apresentar</label><input asp-for="DisplayName" class="form-control" placeholder="Preenchido automaticamente se ficar vazio" /></div>
        <div class="mt-3"><label asp-for="AvatarFileName" class="form-label">Avatar</label><div class="d-flex align-items-center gap-3"><span id="avatar-preview" class="guest-avatar admin-guest-avatar admin-guest-avatar-preview" style="--avatar-scale:@Model.AvatarScale.ToString(System.Globalization.CultureInfo.InvariantCulture);--avatar-position-x:@Model.AvatarPositionX%;--avatar-position-y:@Model.AvatarPositionY%;">@if (!string.IsNullOrWhiteSpace(Model.AvatarFileName)) { <img src="@($"/images/guests/{System.Uri.EscapeDataString(Model.AvatarFileName)}")" alt="" /> } else { <i class="bi bi-person-heart"></i> }</span><select asp-for="AvatarFileName" aria-describedby="avatar-help" asp-items="ViewBag.Avatars" class="form-select"><option value="">Sem avatar</option></select></div><div class="form-text" id="avatar-help">As imagens disponíveis são lidas da pasta <code>wwwroot/images/guests</code>.</div><span asp-validation-for="AvatarFileName" class="text-danger"></span></div>
        <div class="avatar-crop-controls mt-3"><div class="d-flex justify-content-between align-items-center"><h2 class="h6 mb-0">Enquadramento do avatar</h2><button type="button" class="btn btn-sm btn-outline-primary" id="reset-avatar-crop">Repor</button></div><div class="row g-3 mt-1"><div class="col-md-4"><label asp-for="AvatarScale" class="form-label">Tamanho <output data-avatar-value="AvatarScale"></output></label><input asp-for="AvatarScale" type="range" min="1" max="2.5" step="0.05" class="form-range" data-avatar-control /></div><div class="col-md-4"><label asp-for="AvatarPositionX" class="form-label">Posição horizontal <output data-avatar-value="AvatarPositionX"></output></label><input asp-for="AvatarPositionX" type="range" min="0" max="100" step="1" class="form-range" data-avatar-control /></div><div class="col-md-4"><label asp-for="AvatarPositionY" class="form-label">Posição vertical <output data-avatar-value="AvatarPositionY"></output></label><input asp-for="AvatarPositionY" type="range" min="0" max="100" step="1" class="form-range" data-avatar-control /></div></div></div>
        <div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" type="email" class="form-control" /></div><div class="col-md-6"><label asp-for="Phone" class="form-label">Telefone</label><input asp-for="Phone" type="tel" class="form-control" /></div></div>
        <div class="form-check mt-4"><input asp-for="AllowPlusOne" class="form-check-input" /><label asp-for="AllowPlusOne" class="form-check-label">Pode levar acompanhante</label></div>
        <div class="form-check mt-2"><input asp-for="IsPlusOne" class="form-check-input" aria-describedby="plus-one-help" /><label asp-for="IsPlusOne" class="form-check-label">É Plus-One</label></div>
        <div class="mt-3" data-main-guest>
            <label asp-for="MainGuestId" class="form-label">Acompanha</label>
            <select asp-for="MainGuestId" asp-items="ViewBag.MainGuests" class="form-select" aria-describedby="plus-one-help"><option value="">Seleciona o convidado que acompanha</option></select>
            <span asp-validation-for="MainGuestId" class="text-danger"></span>
        </div>
        <p class="form-text" id="plus-one-help">O Plus-One deve pertencer à mesma família/convite da pessoa que acompanha. Quem é Plus-One não pode levar outro acompanhante. A presença é confirmada no RSVP do convidado principal.</p>
        <div class="form-check mt-2"><input asp-for="IsChild" class="form-check-input" /><label asp-for="IsChild" class="form-check-label">É criança</label></div>
        <div class="mt-3"><label asp-for="Notes" class="form-label">Notas internas</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
        <button class="btn btn-primary mt-4">Guardar convidado</button><a class="btn btn-link mt-4" href="/Admin/Guests/Index">Cancelar</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin-guest-avatar.js" asp-append-version="true"></script><script src="~/js/admin-guest-companion.js" asp-append-version="true"></script> }
