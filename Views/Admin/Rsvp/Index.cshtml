@model IEnumerable<Guest>

<div class="container py-5">
    <h1>Respostas de presença</h1>
    <partial name="_AdminFilters" />
    @if (TempData["Success"] is string success)
    {
        <div class="feedback-card feedback-card-success" role="status"><i class="bi bi-check2-circle" aria-hidden="true"></i><span>@success</span></div>
    }
    @if (TempData["Info"] is string info)
    {
        <div class="feedback-card feedback-card-info" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i><span>@info</span></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="feedback-card feedback-card-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>@error</span></div>
    }
    <a class="btn btn-outline-primary" href="@(Url.Action("ExportExcel") + Context.Request.QueryString)">
        <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Exportar histórico em Excel (filtros atuais)
    </a>
    @if (!Model.Any())
    {
        <div class="feedback-card feedback-card-info mt-4 mb-0" role="status"><i class="bi bi-envelope-open-heart" aria-hidden="true"></i><span>Não há convidados nesta seleção.</span></div>
    }
    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Convidado</th>
                <th>Família</th>
                <th>Intenção de presença</th>
                <th class="text-end">Recibo</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var g in Model)
            {
                <tr>
                    <td>@g.DisplayName</td>
                    <td>@g.Family?.Name</td>
                    <td>@(g.CurrentStatus switch { CasamentoTatianaDiogo.Models.Enums.RsvpStatus.Attending => "Vai estar presente", CasamentoTatianaDiogo.Models.Enums.RsvpStatus.NotAttending => "Não vai estar presente", _ => "Por responder" })</td>
                    <td class="text-end">
                        @if (g.IsPlusOne && g.CurrentStatus != CasamentoTatianaDiogo.Models.Enums.RsvpStatus.Pending)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="/Admin/Rsvp/Details/@g.MainGuestId">Ver resposta principal</a>
                        }
                        @if (g.RsvpResponses.Any())
                        {
                            <a class="btn btn-sm btn-outline-primary" href="/Admin/Rsvp/Details/@g.Id"><i class="bi bi-receipt"></i> Consultar</a>
                            <form method="post" action="/Admin/Rsvp/Delete/@g.Id" class="d-inline" data-delete-confirmation data-delete-message="Queres mesmo apagar a resposta de «@g.DisplayName»? O convite voltará a ficar por responder.">
                                <input type="hidden" name="rsvpVersion" value="@(g.Family!.RsvpVersion)" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash3"></i> Apagar resposta
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
