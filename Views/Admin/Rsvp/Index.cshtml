@model IEnumerable<Guest>

<div class="container py-5">
    <h1>RSVP Management</h1>
    <a class="btn btn-outline-primary" href="/Admin/Rsvp/ExportCsv">
        Export CSV
    </a>
    <table class="table">
        <thead>
            <tr>
                <th>Guest</th>
                <th>Family</th>
                <th>Status</th>
                <th>Set</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var g in Model)
            {
                <tr>
                    <td>@g.DisplayName</td>
                    <td>@g.Family?.Name</td>
                    <td>@g.CurrentStatus</td>
                    <td>
                        <form method="post" action="/Admin/Rsvp/SetStatus/@g.Id">
                            @Html.AntiForgeryToken()
                            <select name="status" class="form-select form-select-sm d-inline w-auto">
                                <option>Pending</option>
                                <option>Attending</option>
                                <option>NotAttending</option>
                            </select>
                            <button class="btn btn-sm btn-primary">Save</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>