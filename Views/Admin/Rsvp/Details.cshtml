@inject CasamentoTatianaDiogo.Services.Interfaces.IWeddingSettingsService ContactSettings
@model RsvpResponse
@inject CasamentoTatianaDiogo.Services.WeddingClock Clock
@{
    ViewData["Title"] = T("Recibo de resposta");
    var attendance = Model.Status == CasamentoTatianaDiogo.Models.Enums.RsvpStatus.Attending
        ? T("Vai estar presente") : T("Não vai estar presente");
    var verifiedContact = ViewData["VerifiedInvitationContact"] as RsvpInvitationContact;
}

<div class="container py-5 narrow">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="text-uppercase small text-muted mb-1">@T("Recibo de resposta")</p>
            <h1 class="mb-1">@Model.Guest?.DisplayName</h1>
            <p class="text-muted mb-0">@Model.Guest?.Family?.Name</p>
        </div>
        <a class="btn btn-outline-primary" href="/Admin/Rsvp/Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> @T("Voltar às respostas")</a>
    </div>

    <p><a asp-action="History" asp-route-id="@Model.GuestId">@T("Consultar histórico de alterações")</a></p>
    <article class="admin-form">
        <dl class="row mb-0">
            <dt class="col-sm-4">@T("Intenção de presença")</dt><dd class="col-sm-8">@attendance</dd>
            @if (verifiedContact != null)
            {
                <dt class="col-sm-4">@(verifiedContact.Channel == RsvpVerificationChannel.Email ? T("Email verificado") : T("Contacto anterior"))</dt><dd class="col-sm-8">@(CasamentoTatianaDiogo.Services.ContactFormats.Email(verifiedContact.NormalizedContact, await ContactSettings.GetAsync())?.Display ?? verifiedContact.NormalizedContact)</dd>
            }
            <dt class="col-sm-4">@T("Enviada em")</dt><dd class="col-sm-8">@Clock.ToLocal(Model.SubmittedAt).ToString(T("dd/MM/yyyy 'às' HH:mm"))</dd>
            @if (Model.UpdatedAt.HasValue) { <dt class="col-sm-4">@T("Atualizada em")</dt><dd class="col-sm-8">@Clock.ToLocal(Model.UpdatedAt.Value).ToString(T("dd/MM/yyyy 'às' HH:mm"))</dd> }
            @if (!string.IsNullOrWhiteSpace(Model.DietaryRestrictions)) { <dt class="col-sm-4">@T("Restrições alimentares")</dt><dd class="col-sm-8">@Model.DietaryRestrictions</dd> }
            @if (!string.IsNullOrWhiteSpace(Model.MusicRequest)) { <dt class="col-sm-4">@T("Sugestão musical")</dt><dd class="col-sm-8">@Model.MusicRequest</dd> }
            @if (!string.IsNullOrWhiteSpace(Model.Message)) { <dt class="col-sm-4">@T("Mensagem")</dt><dd class="col-sm-8">@Model.Message</dd> }
        </dl>
    </article>

    @if (Model.PlusOneAttending && Model.PlusOne != null)
    {
        <article class="admin-form mt-4">
            <h2 class="h4">@T("Acompanhante:") @Model.PlusOne.PlusOneDisplayName</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">@T("Presença")</dt><dd class="col-sm-8">@T("Vai estar presente")</dd>
                @if (!string.IsNullOrWhiteSpace(Model.PlusOneDietaryRestrictions)) { <dt class="col-sm-4">@T("Restrições alimentares")</dt><dd class="col-sm-8">@Model.PlusOneDietaryRestrictions</dd> }
                @if (!string.IsNullOrWhiteSpace(Model.PlusOneMusicRequest)) { <dt class="col-sm-4">@T("Sugestão musical")</dt><dd class="col-sm-8">@Model.PlusOneMusicRequest</dd> }
                @if (!string.IsNullOrWhiteSpace(Model.PlusOneMessage)) { <dt class="col-sm-4">@T("Mensagem")</dt><dd class="col-sm-8">@Model.PlusOneMessage</dd> }
            </dl>
        </article>
    }
</div>
