@model CasamentoTatianaDiogo.ViewModels.Admin.RsvpHistoryPage
@inject CasamentoTatianaDiogo.Services.WeddingClock Clock
@{
    ViewData["Title"] = T("Histórico de alterações do RSVP");
    string HistoryValue(string field, string? value) => value == null ? "—" : field is "Presença" or "Presença de acompanhante" ? T(value) : value;
}
<div class="container py-5">
    <h1>@T("Histórico de alterações do RSVP")</h1>
    @if (Model.GuestId.HasValue) { <h2 class="h4">@Model.GuestName</h2> }
    <div class="d-flex flex-wrap gap-3 mb-4">
        <a asp-action="Index">@T("Voltar às respostas")</a>
        @if (Model.GuestId.HasValue) { <a asp-action="History" asp-route-id="">@T("Ver todos os convidados")</a> }
        @if (Model.HasReceipt) { <a asp-action="Details" asp-route-id="@Model.GuestId">@T("Consultar resposta atual")</a> }
    </div>
    @if (Model.Entries.Count == 0)
    {
        <p>@T("Ainda não há alterações registadas. O histórico começa com os envios e eliminações feitos após a ativação desta funcionalidade.")</p>
    }
    else
    {
        <p>@T("Hora local do casamento (")@Clock.TimeZoneId).</p>
        @foreach (var entry in Model.Entries)
        {
            <article class="elegant-card p-3 mb-3">
                <h2 class="h5">@T(entry.Operation) · @entry.GuestName</h2>
                <p><time datetime="@DateTime.SpecifyKind(entry.ChangedAt, DateTimeKind.Utc).ToString("O")">@Clock.ToLocal(entry.ChangedAt).ToString(T("dd/MM/yyyy 'às' HH:mm:ss"))</time>
                    · @entry.Actor @T("· Família") @entry.FamilyName</p>
                <div class="table-responsive"><table class="table align-middle mb-0">
                    <thead><tr><th scope="col">@T("Campo")</th><th scope="col">@T("Antes")</th><th scope="col">@T("Depois")</th></tr></thead>
                    <tbody>@foreach (var field in entry.Fields)
                    {
                        <tr><th scope="row">@T(field.Field)</th><td class="import-value">@HistoryValue(field.Field, field.Before)</td><td class="import-value">@HistoryValue(field.Field, field.After)</td></tr>
                    }</tbody>
                </table></div>
            </article>
        }
        @if (Model.Pages > 1)
        {
            <nav aria-label="@T("Páginas do histórico")" class="d-flex gap-3">
                @if (Model.Page > 1) { <a asp-action="History" asp-route-id="@Model.GuestId" asp-route-page="@(Model.Page - 1)">@T("Anterior")</a> }
                <span>@T("Página") @Model.Page @T("de") @Model.Pages</span>
                @if (Model.Page < Model.Pages) { <a asp-action="History" asp-route-id="@Model.GuestId" asp-route-page="@(Model.Page + 1)">@T("Seguinte")</a> }
            </nav>
        }
    }
</div>
@section Styles { <link rel="stylesheet" href="~/css/pages/admin-import.css" asp-append-version="true" /> }
