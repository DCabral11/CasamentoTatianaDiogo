@model PhotoUploadViewModel
@inject CasamentoTatianaDiogo.Services.Interfaces.ISiteContentService SiteContent
@{
    var siteText = await SiteContent.GetAsync();
    var uploadLabel = siteText.GetValueOrDefault("NavPhotos", "Enviar fotografias");
    ViewData["Title"] = uploadLabel;
}

<section class="page-header">
    <div class="container"><h1><i class="bi bi-camera" aria-hidden="true"></i> @uploadLabel</h1><p>@Model.Message</p></div>
</section>

<div class="container py-5 narrow">
    @if (!Model.IsOpen)
    {
        <div class="elegant-card p-5 text-center"><i class="bi bi-camera display-1"></i><h2>@Model.Message</h2></div>
    }
    else
    {
        <form asp-action="Upload" enctype="multipart/form-data" method="post" class="elegant-card p-4"
              data-photo-upload data-begin-url="@Url.Action("BeginUpload")" data-chunk-url="@Url.Action("UploadChunk")"
              data-max-file-mb="@Model.Settings.MaxFilesSizeMb" data-extensions="@Model.Settings.AllowedExtensionsCsv">
            @Html.AntiForgeryToken()
            <input asp-for="GuestName" class="form-control mb-3" placeholder="@siteText.GetValueOrDefault("PhotosNamePlaceholder", "O teu nome (opcional)")" />
            <textarea asp-for="Notes" class="form-control mb-3" placeholder="@siteText.GetValueOrDefault("PhotosMessagePlaceholder", "Mensagem (opcional)")"></textarea>
            <div class="dropzone"><i class="bi bi-cloud-arrow-up"></i><input asp-for="Files" type="file" multiple required accept=".jpg,.jpeg,.png,.heic,.heif,image/jpeg,image/png,image/heic,image/heif" class="form-control" /></div>
            <small>Tamanho máximo: @Model.Settings.MaxFilesSizeMb MB. Formatos permitidos: @Model.Settings.AllowedExtensionsCsv</small>
            <button class="btn btn-primary rounded-pill mt-3">Enviar fotografias</button>
            <p class="mt-3 mb-0" data-upload-status role="status" aria-live="polite" hidden></p>
            <p class="text-danger mt-3 mb-0" data-upload-error role="alert" hidden></p>
            <noscript><p class="mt-3">Ativa o JavaScript para enviar fotografias grandes. Sem JavaScript, o envio completo deve ter menos de 4 MB.</p></noscript>
        </form>
    }
</div>
@section Scripts {
    <script src="~/js/photo-upload.js" asp-append-version="true"></script>
}
